generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COLLABORATOR
  PJ
  /// @deprecated Migrado para CLIENT_GESTOR — mantido para compatibilidade.
  CLIENT
  CLIENT_GESTOR
  CLIENT_MEMBER
}

/// Papel do usuário CLIENT_* em uma empresa (membership multi-tenant).
enum ClientCompanyRole {
  CLIENT_GESTOR
  CLIENT_MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PermissionModule {
  DASHBOARD
  FINANCIAL
  GMUD
  REPORTS
  ADMIN
  COMPANIES
  USERS
  PERMISSIONS
  CONTRACTS
  MONITORING
  TICKETS
  DOCUMENTATION
  PROJECTS
  SLA
  BILLING
  RENDIMENTO
  CORREIO
  INVENTARIO
}

enum MailboxNotificationKind {
  RENDIMENTO_ALERT
  RENDIMENTO_APPROVAL_PENDING
  CONTRACT_USAGE
  GMUD_PENDING_APPROVAL
  TICKET_NO_APPOINTMENT_24H
  TICKET_STALLED_48H
  TICKET_STALLED_7D
  INVENTORY_EXPIRY
  TIFLUX_SYNC_STALE
}

enum ContractFileType {
  CONTRACT
  SLA
  ATTACHMENT
}

enum GmudStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_EXECUTION
  EXECUTED
  REJECTED
  CANCELED
}

enum GmudApproverStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String?              @map("password_hash")
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  firstAccess         Boolean              @default(true) @map("first_access")
  tokenVersion        Int                  @default(0) @map("token_version")
  responsible         Boolean              @default(false)
  companyId           String?              @map("company_id")
  googleId            String?              @unique @map("google_id")
  microsoftId         String?              @unique @map("microsoft_id")
  provider            String?
  lastSeenAt          DateTime?            @map("last_seen_at")
  rendimentoCustomSchedule    Boolean              @default(false) @map("rendimento_custom_schedule")
  rendimentoDailyWorkMinutes  Int?                 @map("rendimento_daily_work_minutes")
  rendimentoLunchMinutes      Int?                 @map("rendimento_lunch_minutes")
  totpSecretEncrypted String?              @map("totp_secret_encrypted") @db.Text
  totpEnabledAt       DateTime?            @map("totp_enabled_at")
  totpBackupCodesHash String?              @map("totp_backup_codes_hash") @db.Text
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  specialtyId         String?              @map("specialty_id")
  specialty           Specialty?           @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  company             Company?             @relation(fields: [companyId], references: [id])
  companyMemberships  UserCompany[]
  dashboardChartPresets DashboardChartPreset[]
  preTicketsAsRequestor PreTicket[]       @relation("PreTicketRequestor")
  preTicketsOpened      PreTicket[]       @relation("PreTicketOpenedBy")
  emailInboundRoutesCreated EmailInboundRoute[] @relation("EmailInboundRouteCreator")
  permissions         Permission[]
  passwordResetTokens PasswordResetToken[]
  uploadedFiles       File[]               @relation("UserUploadedFiles")
  createdGmuds        Gmud[]               @relation("UserCreatedGmuds")
  responsibleGmuds    Gmud[]               @relation("UserResponsibleGmuds")
  gmudExecutions      GmudExecutor[]
  gmudApprovals       GmudApprover[]
  gmudActivityExecutions GmudActivity[]    @relation("GmudActivityExecutor")
  gmudAttachmentUploads GmudAttachment[]   @relation("GmudAttachmentUploader")
  auditLogs           AuditLog[]
  mailboxNotifications MailboxNotification[]
  inventoryAssetsCreated InventoryAsset[] @relation("InventoryAssetCreator")
  tifluxOutboxEntries    PortalTifluxOutbox[]
  portalTicketAppointments PortalTicketAppointment[]
  portalTicketAppointmentAttachments PortalTicketAppointmentAttachment[] @relation("PortalTicketAppointmentAttachmentCreator")
  portalTicketGmudLinks PortalTicketGmudLink[]
  portalTicketDescriptions PortalTicketDescription[] @relation("PortalTicketDescriptionCreator")
  portalTickets            PortalTicket[]            @relation("PortalTicketCreator")
  appointmentQuestionsAsked RendimentoAppointmentQuestion[] @relation("RendimentoQuestionAskedBy")
  appointmentQuestionsAnswered RendimentoAppointmentQuestion[] @relation("RendimentoQuestionAnsweredBy")
  rendimentoDayEvents          RendimentoDayEvent[]           @relation("RendimentoDayEvents")
  rendimentoGapJustifications  RendimentoGapJustification[]   @relation("RendimentoGapJustifications")
  rendimentoOvertimeBalance    RendimentoOvertimeBalance?     @relation("RendimentoOvertimeBalances")
  rendimentoListPrefsAsCollaborator RendimentoCollaboratorListPref[] @relation("RendimentoListPrefCollaborator")
  projectsCreated                   Project[]                        @relation("ProjectCreator")
  projectsCompletionApproved        Project[]                        @relation("ProjectCompletionApprover")
  projectActivitiesAssigned         ProjectActivity[]                @relation("ProjectActivityAssignee")
  projectHistoryActs                ProjectHistory[]                 @relation("ProjectHistoryActor")

  @@index([companyId])
  @@map("users")
}

model MailboxNotification {
  id        String                   @id @default(uuid())
  userId    String                   @map("user_id")
  kind      MailboxNotificationKind
  title     String
  body      String
  href      String?
  payload   Json?
  dedupeKey String                   @map("dedupe_key")
  readAt    DateTime?                @map("read_at")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("mailbox_notifications")
}

model Company {
  id                   String                    @id @default(uuid())
  name                 String
  responsibleName      String                    @map("responsible_name")
  email                String
  cnpj                 String?
  address              String?
  status               Boolean                   @default(true)

  zabbixGroupName      String?                   @map("zabbix_group_name")
  monitoringPriority   Boolean                   @default(false) @map("monitoring_priority")
  tifluxClientId       Int?                      @map("tiflux_client_id")
  tifluxClientName String?                       @map("tiflux_client_name")

  logoFileId           String?                   @unique @map("logo_file_id")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  deletedAt            DateTime?                 @map("deleted_at")

  logoFile             File?                     @relation("CompanyLogo", fields: [logoFileId], references: [id])
  users                User[]
  contracts            Contract[]
  gmuds                Gmud[]
  reports              Report[]
  billingEntries       BillingEntry[]
  zabbixHosts          IntegrationZabbixHost[]
  preTickets           PreTicket[]
  emailInboundRoutes   EmailInboundRoute[]
  tifluxAccounts       IntegrationTiFluxAccount[]
  usageAlertRules      UsageAlertRule[]
  inventoryAssets      InventoryAsset[]
  appointmentQuestions RendimentoAppointmentQuestion[]
  projects             Project[]
  modules              CompanyModule[]
  userMemberships      UserCompany[]
  dashboardChartPresets DashboardChartPreset[]

  @@unique([cnpj])
  @@map("companies")
}

/// Vínculo usuário ↔ empresa (mesmo e-mail pode atender mais de um cliente).
model UserCompany {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  companyId  String            @map("company_id")
  clientRole ClientCompanyRole @map("client_role")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

/// Preset de gráfico do dashboard por usuário+empresa+visão+widget.
model DashboardChartPreset {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  companyId  String   @map("company_id")
  /// ALLE | INTERNAL
  viewMode   String   @default("ALLE") @map("view_mode") @db.VarChar(20)
  /// CHAMADOS | HORAS | ALERTAS
  chartKey   String   @default("CHAMADOS") @map("chart_key") @db.VarChar(32)
  chartType  String   @default("bar") @map("chart_type") @db.VarChar(32)
  deskNames  String[] @default([]) @map("desk_names")
  periodDays Int      @default(30) @map("period_days")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, viewMode, chartKey])
  @@index([companyId])
  @@map("dashboard_chart_presets")
}

/// Módulos contratados (pack vendido) por empresa. Staff Alle ignora; CLIENT_* intersecta.
model CompanyModule {
  id        String           @id @default(uuid())
  companyId String           @map("company_id")
  module    PermissionModule
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module])
  @@index([companyId])
  @@map("company_modules")
}

model InventoryAssetType {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assets InventoryAsset[]

  @@map("inventory_asset_types")
}

model InventoryAsset {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  assetTypeId        String    @map("asset_type_id")
  name               String
  brand              String?
  quantity           Int?
  supplier           String?
  supplierThirdParty Boolean   @default(false) @map("supplier_third_party")
  unit               String?
  dueDate            DateTime? @map("due_date") @db.Date
  description        String?
  reminderDaysBefore Int?      @map("reminder_days_before")
  notes              String?
  fileId             String?   @map("file_id")
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetType InventoryAssetType @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  file      File?              @relation(fields: [fileId], references: [id], onDelete: SetNull)
  creator   User               @relation("InventoryAssetCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([assetTypeId])
  @@index([dueDate])
  @@map("inventory_assets")
}

/// Especialidade operacional (ex.: NOC, Infra, Consult). Substitui o antigo conceito de "mesa de serviço".
model Specialty {
  id           String            @id @default(uuid())
  /// ID legado externo (integração histórica). Não usar como conceito de produto.
  externalId   Int?              @unique @map("external_id")
  name         String            @unique
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  users               User[]
  classifications     SpecialtyClassification[]
  contractSpecialties ContractSpecialty[]
  emailInboundRoutes  EmailInboundRoute[]
  preTickets          PreTicket[]
  portalTickets       PortalTicket[]

  @@map("specialties")
}

/// Hierarquia de classificação sob a especialidade: no máximo 2 níveis.
model SpecialtyClassification {
  id          String   @id @default(uuid())
  specialtyId String   @map("specialty_id")
  parentId    String?  @map("parent_id")
  name        String
  level       Int
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  specialty Specialty                  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  parent    SpecialtyClassification?   @relation("SpecialtyClassificationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  SpecialtyClassification[]  @relation("SpecialtyClassificationTree")
  contracts Contract[]

  @@unique([specialtyId, parentId, name])
  @@index([specialtyId])
  @@index([parentId])
  @@map("specialty_classifications")
}

/// Linha de especialidade dentro de um contrato (N especialidades por contrato).
model ContractSpecialty {
  id              String   @id @default(uuid())
  contractId      String   @map("contract_id")
  specialtyId     String   @map("specialty_id")
  monthlyHours    Int      @default(0) @map("monthly_hours")
  unlimited       Boolean  @default(false)
  contractValue   Decimal  @default(0) @db.Decimal(12, 2) @map("contract_value")
  excessHourPrice Decimal  @default(0) @db.Decimal(10, 2) @map("excess_hour_price")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contract  Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([contractId, specialtyId])
  @@index([specialtyId])
  @@map("contract_specialties")
}

model Permission {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  module     PermissionModule
  canView    Boolean          @default(false) @map("can_view")
  canCreate  Boolean          @default(false) @map("can_create")
  canEdit    Boolean          @default(false) @map("can_edit")
  canDelete  Boolean          @default(false) @map("can_delete")
  canApprove Boolean          @default(false) @map("can_approve")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@map("permissions")
}

model Contract {
  id               String           @id @default(uuid())
  companyId        String           @map("company_id")
  /// @deprecated Preferir contract_specialties; mantido para leitura legada.
  classificationId String?          @map("classification_id")
  title            String
  description      String?
  status           ContractStatus
  /// @deprecated Preferir horas por linha em contract_specialties.
  monthlyHours     Int              @map("monthly_hours")
  /// @deprecated Preferir excess_hour_price em contract_specialties.
  extraHourPrice   Decimal          @db.Decimal(10, 2) @map("extra_hour_price")
  startDate        DateTime         @map("start_date")
  endDate          DateTime?        @map("end_date")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  company          Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  classification   SpecialtyClassification?   @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  specialties      ContractSpecialty[]
  contractFiles    ContractFile[]
  billingEntries   BillingEntry[]

  @@index([companyId])
  @@index([classificationId])
  @@map("contracts")
}

model ContractFile {
  id         String           @id @default(uuid())
  contractId String           @map("contract_id")
  fileId     String           @map("file_id")
  type       ContractFileType

  contract   Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  file       File             @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([fileId])
  @@map("contract_files")
}

model File {
  id                 String         @id @default(uuid())
  originalName       String         @map("original_name")
  mimeType           String         @map("mime_type")
  path               String
  size               Int
  uploadedBy         String         @map("uploaded_by")
  createdAt          DateTime       @default(now()) @map("created_at")
  deletedAt          DateTime?      @map("deleted_at")

  uploadedByUser     User           @relation("UserUploadedFiles", fields: [uploadedBy], references: [id])
  companyLogoFor     Company?       @relation("CompanyLogo")
  contractFiles      ContractFile[]
  reports            Report[]
  gmudAttachments    GmudAttachment[]
  inventoryAssets    InventoryAsset[]
  portalTicketAppointmentAttachments PortalTicketAppointmentAttachment[]
  projectDocuments   ProjectDocument[]
  preTicketAttachments PreTicketAttachment[]

  @@index([uploadedBy])
  @@map("files")
}

model PasswordResetToken {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  /// SHA-256 HMAC do código (nunca armazenar o código em claro).
  token           String    @unique
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

enum ReportType {
  RENDIMENTO        @map("1")
  ESTATISTICA_GERAL @map("4")
  INVENTARIO        @map("5")
  COBRANCA          @map("6")
}

enum ReportStatus {
  READY
  FAILED
}

enum ReportFormat {
  CSV
  XLSX
}

model Gmud {
  id                 String         @id @default(uuid())
  code               Int            @unique @default(autoincrement())
  companyId          String         @map("company_id")
  title              String
  downtime           Boolean        @default(false)
  downtimeStart      DateTime?      @map("downtime_start")
  downtimeEnd        DateTime?      @map("downtime_end")
  responsibleId      String?        @map("responsible_id")
  summary            String?
  description        String?
  reason             String?
  impact             String?
  rollback           String?
  status             GmudStatus     @default(DRAFT)
  createdBy          String         @map("created_by")
  approvedAt         DateTime?      @map("approved_at")
  executionStartedAt DateTime?      @map("execution_started_at")
  executedAt         DateTime?      @map("executed_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator            User           @relation("UserCreatedGmuds", fields: [createdBy], references: [id])
  responsible        User?          @relation("UserResponsibleGmuds", fields: [responsibleId], references: [id])
  executors          GmudExecutor[]
  approvers          GmudApprover[]
  activities         GmudActivity[]
  attachments        GmudAttachment[]

  @@index([companyId])
  @@index([status])
  @@index([createdBy])
  @@index([responsibleId])
  @@map("gmud")
}

model GmudExecutor {
  id        String   @id @default(uuid())
  gmudId    String   @map("gmud_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  gmud      Gmud     @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gmudId, userId])
  @@index([gmudId])
  @@index([userId])
  @@map("gmud_executors")
}

model GmudApprover {
  id             String              @id @default(uuid())
  gmudId         String              @map("gmud_id")
  userId         String              @map("user_id")
  status         GmudApproverStatus  @default(PENDING)
  decidedAt      DateTime?           @map("decided_at")
  decisionNote   String?             @map("decision_note")

  gmud           Gmud                @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gmudId, userId])
  @@index([gmudId])
  @@index([userId])
  @@map("gmud_approvers")
}

model GmudActivity {
  id                String    @id @default(uuid())
  gmudId            String    @map("gmud_id")
  scheduledAt       DateTime  @map("scheduled_at")
  durationMinutes   Int       @map("duration_minutes")
  executorUserId    String    @map("executor_user_id")
  description       String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  gmud              Gmud      @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  executorUser      User      @relation("GmudActivityExecutor", fields: [executorUserId], references: [id], onDelete: Restrict)

  @@index([gmudId])
  @@index([executorUserId])
  @@map("gmud_activities")
}

model GmudAttachment {
  id          String   @id @default(uuid())
  gmudId      String   @map("gmud_id")
  fileId      String   @map("file_id")
  uploadedBy  String   @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  gmud        Gmud     @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploader    User     @relation("GmudAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([gmudId])
  @@index([fileId])
  @@index([uploadedBy])
  @@map("gmud_attachments")
}

model Report {
  id           String       @id @default(uuid())
  companyId    String       @map("company_id")
  type         ReportType
  format       ReportFormat @default(CSV)
  status       ReportStatus @default(READY)
  periodStart  DateTime  @map("period_start")
  periodEnd    DateTime  @map("period_end")
  filters      Json?     
  errorMessage String?   @map("error_message")
  generatedBy  String    @map("generated_by")
  fileId       String    @map("file_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file         File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fileId])
  @@map("reports")
}

model TicketStage {
  id            String    @id @default(uuid())
  name          String
  isSystem      Boolean   @default(false) @map("is_system")
  syncsToTiflux Boolean   @default(false) @map("syncs_to_tiflux")
  active        Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("ticket_stages")
}

model BillingEntry {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  contractId       String    @map("contract_id")
  monthReference   DateTime  @map("month_reference")
  contractedHours  Decimal   @db.Decimal(10, 2) @map("contracted_hours")
  usedHours        Decimal   @db.Decimal(10, 2) @map("used_hours")
  extraHours       Decimal   @db.Decimal(10, 2) @map("extra_hours")
  extraAmount      Decimal   @db.Decimal(10, 2) @map("extra_amount")
  createdAt        DateTime  @default(now()) @map("created_at")

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract         Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contractId])
  @@map("billing_entries")
}

model UsageAlertRule {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  enabled         Boolean  @default(true)
  // dia do mês para rodar (ex.: 15)
  dayOfMonth      Int      @default(15) @map("day_of_month")
  // percentuais (0..100)
  lowThresholdPct Int?     @map("low_threshold_pct")
  highThresholdPct Int?    @map("high_threshold_pct")
  recipients      Json     // { to: string[], cc?: string[] }
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([enabled, dayOfMonth])
  @@map("usage_alert_rules")
}

model IntegrationZabbixHost {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
