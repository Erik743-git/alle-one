enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum ProjectBudgetUnit {
  HOURS
  DAYS
}

enum ProjectCompletionApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ProjectActivityKind {
  PHASE
  TASK
  MILESTONE
}

enum ProjectActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProjectHistoryEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_REOPENED
  PROJECT_CLOSED
  PHASE_CREATED
  PHASE_UPDATED
  PHASE_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  APPOINTMENT_LINKED
}

model Project {
  id          String        @id @default(uuid())
  code        Int           @unique @default(autoincrement())
  companyId   String        @map("company_id")
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  budgetUnit  ProjectBudgetUnit? @map("budget_unit")
  budgetAmount Int?         @map("budget_amount")
  completionApprovalStatus ProjectCompletionApprovalStatus @default(NOT_REQUIRED) @map("completion_approval_status")
  completionApprovedBy String? @map("completion_approved_by")
  completionApprovedAt DateTime? @map("completion_approved_at")
  completionApprovalNote String? @map("completion_approval_note")
  ticketNumber Int? @unique @map("ticket_number")
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator    User              @relation("ProjectCreator", fields: [createdBy], references: [id])
  completionApprover User?     @relation("ProjectCompletionApprover", fields: [completionApprovedBy], references: [id])
  activities ProjectActivity[]
  documents  ProjectDocument[]
  history    ProjectHistory[]

  @@index([companyId])
  @@index([status])
  @@index([completionApprovalStatus])
  @@index([ticketNumber])
  @@map("projects")
}

model ProjectActivity {
  id                   String                @id @default(uuid())
  projectId            String                @map("project_id")
  parentId             String?               @map("parent_id")
  wbsCode              String                @map("wbs_code")
  name                 String
  kind                 ProjectActivityKind   @default(TASK)
  level                Int                   @default(1)
  sortOrder            Int                   @default(0) @map("sort_order")
  durationDays         Int                   @default(1) @map("duration_days")
  durationHours        Int?                  @map("duration_hours")
  startDate            DateTime?             @map("start_date") @db.Date
  endDate              DateTime?             @map("end_date") @db.Date
  actualDurationDays   Int?                  @map("actual_duration_days")
  actualDurationHours  Int?                  @map("actual_duration_hours")
  progressPercent      Int                   @default(0) @map("progress_percent")
  activityStatus       ProjectActivityStatus @default(NOT_STARTED) @map("activity_status")
  completedAt          DateTime?             @map("completed_at")
  assigneeUserId       String?               @map("assignee_user_id")
  assigneeName         String?               @map("assignee_name")
  isMilestone          Boolean               @default(false) @map("is_milestone")
  notes                String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  project      Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       ProjectActivity?             @relation("ProjectActivityTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     ProjectActivity[]            @relation("ProjectActivityTree")
  assignee     User?                        @relation("ProjectActivityAssignee", fields: [assigneeUserId], references: [id])
  predecessors ProjectActivityPredecessor[] @relation("ActivitySuccessors")
  successors   ProjectActivityPredecessor[] @relation("ActivityPredecessors")
  appointments ProjectActivityAppointment[]

  @@unique([projectId, wbsCode])
  @@index([projectId])
  @@index([parentId])
  @@index([assigneeUserId])
  @@index([kind])
  @@index([activityStatus])
  @@map("project_activities")
}

model ProjectHistory {
  id          String                  @id @default(uuid())
  projectId   String                  @map("project_id")
  eventType   ProjectHistoryEventType @map("event_type")
  entityType  String?                 @map("entity_type")
  entityId    String?                 @map("entity_id")
  summary     String
  payload     Json?
  actorUserId String?                 @map("actor_user_id")
  createdAt   DateTime                @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ProjectHistoryActor", fields: [actorUserId], references: [id])

  @@index([projectId, createdAt])
  @@map("project_history")
}

model ProjectActivityPredecessor {
  id            String   @id @default(uuid())
  activityId    String   @map("activity_id")
  predecessorId String   @map("predecessor_id")
  createdAt     DateTime @default(now()) @map("created_at")

  activity    ProjectActivity @relation("ActivitySuccessors", fields: [activityId], references: [id], onDelete: Cascade)
  predecessor ProjectActivity @relation("ActivityPredecessors", fields: [predecessorId], references: [id], onDelete: Cascade)

  @@unique([activityId, predecessorId])
  @@index([activityId])
  @@index([predecessorId])
  @@map("project_activity_predecessors")
}

model ProjectActivityAppointment {
  id                  String   @id @default(uuid())
  activityId          String   @map("activity_id")
  portalAppointmentId String   @unique @map("portal_appointment_id")
  minutes             Int
  createdAt           DateTime @default(now()) @map("created_at")

  activity          ProjectActivity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  portalAppointment PortalTicketAppointment @relation(fields: [portalAppointmentId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("project_activity_appointments")
}

model ProjectDocument {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  fileId    String   @map("file_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fileId])
  @@map("project_documents")
}

enum PreTicketStatus {
  PENDING
  OPENED
  DELETED
  IGNORED
}

/// Pré-ticket gerado por e-mail (Microsoft Graph) antes de virar portal_tickets.
