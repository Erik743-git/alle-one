  title             String
  descriptionHtml   String?         @map("description_html") @db.Text
  descriptionText   String?         @map("description_text") @db.Text
  fromName          String?         @map("from_name")
  fromEmail         String          @map("from_email")
  toEmails          String[]        @map("to_emails")
  channel           String          @default("E-mail") @db.VarChar(40)
  mailboxAddress    String          @map("mailbox_address")
  messageId         String          @unique @map("message_id")
  graphMessageId    String?         @map("graph_message_id")
  conversationId    String?         @map("conversation_id")
  inReplyTo         String?         @map("in_reply_to")
  referencesHeader  String?         @map("references_header") @db.Text
  possibleDuplicateSubject Boolean  @default(false) @map("possible_duplicate_subject")
  linkedTicketNumber Int?           @map("linked_ticket_number")
  appliedToTicket   Boolean         @default(false) @map("applied_to_ticket")
  companyId         String?         @map("company_id")
  requestorUserId   String?         @map("requestor_user_id")
  specialtyId       String?         @map("specialty_id")
  priorityName      String?         @map("priority_name") @db.VarChar(80)
  attachmentCount   Int             @default(0) @map("attachment_count")
  ticketNumber      Int?            @map("ticket_number")
  openedByUserId    String?         @map("opened_by_user_id")
  openedAt          DateTime?       @map("opened_at")
  deletedAt         DateTime?       @map("deleted_at")
  receivedAt        DateTime        @map("received_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  requestorUser User?        @relation("PreTicketRequestor", fields: [requestorUserId], references: [id], onDelete: SetNull)
  openedByUser  User?        @relation("PreTicketOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  specialty     Specialty?   @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  attachments   PreTicketAttachment[]

  @@index([status, receivedAt])
  @@index([fromEmail])
  @@index([mailboxAddress])
  @@index([conversationId])
  @@index([linkedTicketNumber])
  @@map("pre_tickets")
}

model PreTicketAttachment {
  id          String   @id @default(uuid())
  preTicketId String   @map("pre_ticket_id")
  fileId      String   @map("file_id")
  fileName    String   @map("file_name")
  contentType String?  @map("content_type")
  sizeBytes   Int?     @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  preTicket PreTicket @relation(fields: [preTicketId], references: [id], onDelete: Cascade)
  file      File      @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([preTicketId])
  @@map("pre_ticket_attachments")
}

/// Direcionamento de e-mail inbound (estilo TiFlux Recebimento).
model EmailInboundRoute {
  id            String   @id @default(uuid())
  matchEmail    String   @map("match_email")
  specialtyId   String?  @map("specialty_id")
  companyId     String?  @map("company_id")
  priorityName  String?  @map("priority_name") @db.VarChar(80)
  verified      Boolean  @default(false)
  active        Boolean  @default(true)
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  specialty Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  creator   User?      @relation("EmailInboundRouteCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([matchEmail])
  @@index([active])
  @@map("email_inbound_routes")
}

/// Config singleton da caixa Microsoft Graph (id fixo "default").
model EmailInboundSettings {
  id                    String   @id @default("default")
  sharedMailboxAddress  String?  @map("shared_mailbox_address")
  useAsRequester        String   @default("Remetente") @map("use_as_requester") @db.VarChar(40)
  graphTenantId         String?  @map("graph_tenant_id")
  graphClientId         String?  @map("graph_client_id")
  /// Secret fica preferencialmente em env GRAPH_CLIENT_SECRET; campo opcional criptografado.
  graphClientSecretEnc  String?  @map("graph_client_secret_enc") @db.Text
  deltaLink             String?  @map("delta_link") @db.Text
  lastPolledAt          DateTime? @map("last_polled_at")
  enabled               Boolean  @default(false)
  /// Remetentes/domínios que não viram pré-ticket (um por linha: email@x.com ou *@dominio.com).
  blockedSenders        String?  @map("blocked_senders") @db.Text
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("email_inbound_settings")
}
