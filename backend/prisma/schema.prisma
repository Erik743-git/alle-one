enum PortalTifluxOutboxKind {
  CREATE_TICKET
  CREATE_APPOINTMENT
  UPDATE_TICKET
  UPDATE_APPOINTMENT
}

enum PortalTifluxOutboxStatus {
  PENDING
  SYNCED
  FAILED
}

/// Fila de escrita portal → TiFlux (opção A). Leitura canônica: schema tiflux.*
model PortalTifluxOutbox {
  id                String                   @id @default(uuid())
  kind              PortalTifluxOutboxKind
  status            PortalTifluxOutboxStatus @default(PENDING)
  ticketNumber      Int?                     @map("ticket_number")
  tifluxExternalId  Int?                     @map("tiflux_external_id")
  payload           Json
  errorMessage      String?                  @map("error_message")
  createdBy         String                   @map("created_by")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  syncedAt          DateTime?                @map("synced_at")

  creator           User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  appointmentAttachments PortalTicketAppointmentAttachment[]
  portalAppointments     PortalTicketAppointment[]

  @@index([status, createdAt])
  @@index([ticketNumber])
  @@map("portal_tiflux_outbox")
}

enum PortalTicketAppointmentSyncStatus {
  PENDING_TIFLUX
  SYNCED
  PORTAL_ONLY
}

enum PortalTicketOrigin {
  TIFLUX
  PORTAL
}

/// Ticket canônico do portal (cutover TiFlux). Ver docs/CUTOVER_TIFLUX.md.
model PortalTicket {
  id                      String             @id @default(uuid())
  ticketNumber            Int                @unique @map("ticket_number")
  title                   String?
  clientName              String?            @map("client_name")
  clientExternalId        Int?               @map("client_external_id")
  createdByWayOf          String?            @map("created_by_way_of") @db.VarChar(120)
  priorityName            String?            @map("priority_name")
  statusName              String?            @map("status_name")
  stageName               String?            @map("stage_name")
  responsibleExternalId   Int?               @map("responsible_external_id")
  responsibleName         String?            @map("responsible_name")
  deskName                String?            @map("desk_name")
  deskExternalId          Int?               @map("desk_external_id")
  specialtyId             String?            @map("specialty_id")
  requestorName           String?            @map("requestor_name")
  requestorEmail          String?            @map("requestor_email")
  requestorTelephone      String?            @map("requestor_telephone")
  isClosed                Boolean            @default(false) @map("is_closed")
  origin                  PortalTicketOrigin @default(TIFLUX)
  /// ConversationId do Microsoft Graph (thread de e-mail).
  emailConversationId     String?            @map("email_conversation_id")
  /// Chamado pai quando este ticket foi agrupado (filho cancelado).
  parentTicketNumber      Int?               @map("parent_ticket_number")
  createdAtSource         DateTime?          @map("created_at_source")
  updatedAtSource         DateTime?          @map("updated_at_source")
  createdBy               String?            @map("created_by")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  creator    User?       @relation("PortalTicketCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  specialty  Specialty?  @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  @@index([clientExternalId])
  @@index([isClosed, updatedAtSource])
  @@index([responsibleExternalId])
  @@index([isClosed, responsibleExternalId, updatedAtSource])
  @@index([isClosed, clientExternalId, createdAtSource])
  @@index([specialtyId])
  @@index([emailConversationId])
  @@index([parentTicketNumber])
  @@map("portal_tickets")
}

/// Apontamento criado pelo portal (campos completos). TiFlux recebe só data/hora/descrição quando a API permitir.
model PortalTicketAppointment {
  id                          String                            @id @default(uuid())
  ticketNumber                Int                               @map("ticket_number")
  appointmentDate             DateTime                          @map("appointment_date") @db.Date
  initTime                    String                            @map("init_time") @db.VarChar(5)
  endTime                     String                            @map("end_time") @db.VarChar(5)
  description                 String
  serviceName                 String                            @map("service_name") @db.VarChar(120)
  attendance                  String                            @db.VarChar(20)
  /// Quando true, dispara e-mail ao responsável e aos seguidores.
  notifyClient                Boolean                           @default(false) @map("notify_client")
  tifluxAppointmentExternalId Int?                              @map("tiflux_appointment_external_id")
  syncStatus                  PortalTicketAppointmentSyncStatus @default(PENDING_TIFLUX) @map("sync_status")
  syncPausedAt                DateTime?                         @map("sync_paused_at")
  outboxId                    String?                           @map("outbox_id")
  createdBy                   String                            @map("created_by")
  createdAt                   DateTime                          @default(now()) @map("created_at")
  updatedAt                   DateTime                          @updatedAt @map("updated_at")

  creator     User                                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  outbox      PortalTifluxOutbox?                 @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  attachments PortalTicketAppointmentAttachment[]
  projectActivityLink ProjectActivityAppointment?

  @@index([ticketNumber])
  @@index([tifluxAppointmentExternalId])
  @@index([createdBy, appointmentDate])
  /// UNIQUE parcial via migration SQL (WHERE NOT NULL) — Prisma não modela partial unique.
  @@map("portal_ticket_appointments")
}

/// Anexos do portal em apontamentos (não vão para o TiFlux).
model PortalTicketAppointmentAttachment {
  id                        String   @id @default(uuid())
  ticketNumber              Int      @map("ticket_number")
  portalAppointmentId       String?  @map("portal_appointment_id")
  outboxId                  String?  @map("outbox_id")
  tifluxAppointmentExternalId Int?   @map("tiflux_appointment_external_id")
  fileId                    String   @map("file_id")
  previewDataBase64         String?  @map("preview_data_base64") @db.Text
  createdBy                 String   @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")

  file              File                     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  creator           User                     @relation("PortalTicketAppointmentAttachmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  outbox            PortalTifluxOutbox?      @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  portalAppointment PortalTicketAppointment? @relation(fields: [portalAppointmentId], references: [id], onDelete: SetNull)

  @@index([ticketNumber])
  @@index([outboxId])
  @@index([portalAppointmentId])
  @@map("portal_ticket_appointment_attachments")
}

/// Descrição rica do chamado criada no portal (texto + imagens embutidas).
model PortalTicketDescription {
  ticketNumber Int      @id @map("ticket_number")
  description  String
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator User @relation("PortalTicketDescriptionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("portal_ticket_descriptions")
}

/// Referência GMUD externa (informada pelo cliente) vinculada ao ticket TiFlux.
model PortalTicketGmudLink {
  ticketNumber    Int      @id @map("ticket_number")
  externalGmudRef String   @map("external_gmud_ref") @db.VarChar(120)
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([externalGmudRef])
  @@map("portal_ticket_gmud_links")
}

/// E-mails em cópia (seguidores) do chamado.
model PortalTicketWatcher {
  id           String   @id @default(uuid())
  ticketNumber Int      @map("ticket_number")
  email        String   @db.VarChar(255)
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([ticketNumber, email])
  @@index([ticketNumber])
  @@index([email])
  @@map("portal_ticket_watchers")
}

/// Templates de e-mail parametrizados (Admin → E-mail).
model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(120)
  subject   String   @db.VarChar(500)
  bodyHtml  String   @map("body_html")
  bodyText  String   @map("body_text")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

