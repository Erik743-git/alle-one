/// Cache de eventos do histórico TiFlux (estágios e interações anteriores ao portal).
model TicketHistory {
  id           String   @id @default(uuid())
  ticketNumber Int      @map("ticket_number")
  eventType    String   @map("event_type") @db.VarChar(80)
  summary      String
  actorName    String?  @map("actor_name")
  source       String   @default("TIFLUX") @db.VarChar(20)
  externalKey  String?  @map("external_key") @db.VarChar(255)
  payload      Json?
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ticketNumber, occurredAt])
  @@map("ticket_history")
}

enum RendimentoAppointmentQuestionStatus {
  PENDING
  ANSWERED
}

/// Questionamento de apontamento pela visão empresarial (cliente → admins).
model RendimentoAppointmentQuestion {
  id                String                              @id @default(uuid())
  companyId         String                              @map("company_id")
  appointmentSource String                              @map("appointment_source") @db.VarChar(16)
  appointmentRef    String                              @map("appointment_ref") @db.VarChar(64)
  ticketNumber      Int                                 @map("ticket_number")
  appointmentDate   DateTime                            @map("appointment_date") @db.Date
