generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COLLABORATOR
  PJ
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PermissionModule {
  DASHBOARD
  FINANCIAL
  GMUD
  REPORTS
  ADMIN
  COMPANIES
  USERS
  PERMISSIONS
  CONTRACTS
  MONITORING
  TICKETS
  DOCUMENTATION
  PROJECTS
  SLA
  BILLING
  RENDIMENTO
  CORREIO
  INVENTARIO
}

enum MailboxNotificationKind {
  RENDIMENTO_ALERT
  RENDIMENTO_APPROVAL_PENDING
  CONTRACT_USAGE
  GMUD_PENDING_APPROVAL
  TICKET_NO_APPOINTMENT_24H
  TICKET_STALLED_48H
  TICKET_STALLED_7D
  INVENTORY_EXPIRY
  TIFLUX_SYNC_STALE
}

enum ContractFileType {
  CONTRACT
  SLA
  ATTACHMENT
}

enum GmudStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_EXECUTION
  EXECUTED
  REJECTED
  CANCELED
}

enum GmudApproverStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String?              @map("password_hash")
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  firstAccess         Boolean              @default(true) @map("first_access")
  tokenVersion        Int                  @default(0) @map("token_version")
  responsible         Boolean              @default(false)
  companyId           String?              @map("company_id")
  googleId            String?              @unique @map("google_id")
  microsoftId         String?              @unique @map("microsoft_id")
  provider            String?
  lastSeenAt          DateTime?            @map("last_seen_at")
  rendimentoCustomSchedule    Boolean              @default(false) @map("rendimento_custom_schedule")
  rendimentoDailyWorkMinutes  Int?                 @map("rendimento_daily_work_minutes")
  rendimentoLunchMinutes      Int?                 @map("rendimento_lunch_minutes")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  company             Company?             @relation(fields: [companyId], references: [id])
  permissions         Permission[]
  passwordResetTokens PasswordResetToken[]
  uploadedFiles       File[]               @relation("UserUploadedFiles")
  createdGmuds        Gmud[]               @relation("UserCreatedGmuds")
  responsibleGmuds    Gmud[]               @relation("UserResponsibleGmuds")
  gmudExecutions      GmudExecutor[]
  gmudApprovals       GmudApprover[]
  gmudActivityExecutions GmudActivity[]    @relation("GmudActivityExecutor")
  gmudAttachmentUploads GmudAttachment[]   @relation("GmudAttachmentUploader")
  auditLogs           AuditLog[]
  serviceDeskLinks    UserServiceDesk[]
  mailboxNotifications MailboxNotification[]
  inventoryAssetsCreated InventoryAsset[] @relation("InventoryAssetCreator")
  tifluxOutboxEntries    PortalTifluxOutbox[]
  portalTicketAppointments PortalTicketAppointment[]
  portalTicketAppointmentAttachments PortalTicketAppointmentAttachment[] @relation("PortalTicketAppointmentAttachmentCreator")
  portalTicketGmudLinks PortalTicketGmudLink[]
  portalTicketDescriptions PortalTicketDescription[] @relation("PortalTicketDescriptionCreator")
  appointmentQuestionsAsked RendimentoAppointmentQuestion[] @relation("RendimentoQuestionAskedBy")
  appointmentQuestionsAnswered RendimentoAppointmentQuestion[] @relation("RendimentoQuestionAnsweredBy")
  rendimentoDayEvents          RendimentoDayEvent[]           @relation("RendimentoDayEvents")
  rendimentoGapJustifications  RendimentoGapJustification[]   @relation("RendimentoGapJustifications")
  rendimentoOvertimeBalance    RendimentoOvertimeBalance?     @relation("RendimentoOvertimeBalances")
  rendimentoListPrefsAsCollaborator RendimentoCollaboratorListPref[] @relation("RendimentoListPrefCollaborator")
  projectsCreated                   Project[]                        @relation("ProjectCreator")
  projectsCompletionApproved        Project[]                        @relation("ProjectCompletionApprover")
  projectActivitiesAssigned         ProjectActivity[]                @relation("ProjectActivityAssignee")

  @@index([companyId])
  @@map("users")
}

model MailboxNotification {
  id        String                   @id @default(uuid())
  userId    String                   @map("user_id")
  kind      MailboxNotificationKind
  title     String
  body      String
  href      String?
  payload   Json?
  dedupeKey String                   @map("dedupe_key")
  readAt    DateTime?                @map("read_at")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("mailbox_notifications")
}

model Company {
  id                   String                    @id @default(uuid())
  name                 String
  responsibleName      String                    @map("responsible_name")
  email                String
  cnpj                 String?
  address              String?
  status               Boolean                   @default(true)

  zabbixGroupName      String?                   @map("zabbix_group_name")
  tifluxClientId       Int?                      @map("tiflux_client_id")
  tifluxClientName String?                       @map("tiflux_client_name")

  logoFileId           String?                   @unique @map("logo_file_id")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  deletedAt            DateTime?                 @map("deleted_at")

  logoFile             File?                     @relation("CompanyLogo", fields: [logoFileId], references: [id])
  users                User[]
  contracts            Contract[]
  gmuds                Gmud[]
  reports              Report[]
  billingEntries       BillingEntry[]
  zabbixHosts          IntegrationZabbixHost[]
  tifluxAccounts       IntegrationTiFluxAccount[]
  usageAlertRules      UsageAlertRule[]
  inventoryAssets      InventoryAsset[]
  appointmentQuestions RendimentoAppointmentQuestion[]
  projects             Project[]

  @@unique([cnpj])
  @@map("companies")
}

model InventoryAssetType {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assets InventoryAsset[]

  @@map("inventory_asset_types")
}

model InventoryAsset {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  assetTypeId        String    @map("asset_type_id")
  name               String
  brand              String?
  quantity           Int?
  supplier           String?
  supplierThirdParty Boolean   @default(false) @map("supplier_third_party")
  unit               String?
  dueDate            DateTime? @map("due_date") @db.Date
  description        String?
  reminderDaysBefore Int?      @map("reminder_days_before")
  notes              String?
  fileId             String?   @map("file_id")
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetType InventoryAssetType @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  file      File?              @relation(fields: [fileId], references: [id], onDelete: SetNull)
  creator   User               @relation("InventoryAssetCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([assetTypeId])
  @@index([dueDate])
  @@map("inventory_assets")
}

model ServiceDesk {
  id           String            @id @default(uuid())
  externalId   Int?              @unique @map("external_id")
  name         String            @unique
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  userLinks         UserServiceDesk[]
  classifications ServiceDeskClassification[]

  @@map("service_desks")
}

/// Hierarquia portal sobre a mesa TiFlux: até 3 níveis (ex.: Software → Antivírus → Bitdefender).
model ServiceDeskClassification {
  id            String   @id @default(uuid())
  serviceDeskId String   @map("service_desk_id")
  parentId      String?  @map("parent_id")
  name          String
  level         Int
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  serviceDesk ServiceDesk                 @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)
  parent      ServiceDeskClassification?  @relation("ServiceDeskClassificationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ServiceDeskClassification[] @relation("ServiceDeskClassificationTree")
  contracts   Contract[]

  @@unique([serviceDeskId, parentId, name])
  @@index([serviceDeskId])
  @@index([parentId])
  @@map("service_desk_classifications")
}

model UserServiceDesk {
  userId        String      @map("user_id")
  serviceDeskId String      @map("service_desk_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceDesk   ServiceDesk @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)

  @@id([userId, serviceDeskId])
  @@index([serviceDeskId])
  @@map("user_service_desks")
}

model Permission {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  module     PermissionModule
  canView    Boolean          @default(false) @map("can_view")
  canCreate  Boolean          @default(false) @map("can_create")
  canEdit    Boolean          @default(false) @map("can_edit")
  canDelete  Boolean          @default(false) @map("can_delete")
  canApprove Boolean          @default(false) @map("can_approve")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@map("permissions")
}

model Contract {
  id               String           @id @default(uuid())
  companyId        String           @map("company_id")
  classificationId String?          @map("classification_id")
  title            String
  description      String?
  status           ContractStatus
  monthlyHours     Int              @map("monthly_hours")
  extraHourPrice   Decimal          @db.Decimal(10, 2) @map("extra_hour_price")
  startDate        DateTime         @map("start_date")
  endDate          DateTime?        @map("end_date")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  company          Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  classification   ServiceDeskClassification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  contractFiles    ContractFile[]
  billingEntries   BillingEntry[]

  @@index([companyId])
  @@index([classificationId])
  @@map("contracts")
}

model ContractFile {
  id         String           @id @default(uuid())
  contractId String           @map("contract_id")
  fileId     String           @map("file_id")
  type       ContractFileType

  contract   Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  file       File             @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([fileId])
  @@map("contract_files")
}

model File {
  id                 String         @id @default(uuid())
  originalName       String         @map("original_name")
  mimeType           String         @map("mime_type")
  path               String
  size               Int
  uploadedBy         String         @map("uploaded_by")
  createdAt          DateTime       @default(now()) @map("created_at")
  deletedAt          DateTime?      @map("deleted_at")

  uploadedByUser     User           @relation("UserUploadedFiles", fields: [uploadedBy], references: [id])
  companyLogoFor     Company?       @relation("CompanyLogo")
  contractFiles      ContractFile[]
  reports            Report[]
  gmudAttachments    GmudAttachment[]
  inventoryAssets    InventoryAsset[]
  portalTicketAppointmentAttachments PortalTicketAppointmentAttachment[]
  projectDocuments   ProjectDocument[]

  @@index([uploadedBy])
  @@map("files")
}

model PasswordResetToken {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  /// SHA-256 HMAC do código (nunca armazenar o código em claro).
  token           String    @unique
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

enum ReportType {
  RENDIMENTO        @map("1")
  ESTATISTICA_GERAL @map("4")
  INVENTARIO        @map("5")
}

enum ReportStatus {
  READY
  FAILED
}

enum ReportFormat {
  CSV
  XLSX
}

model Gmud {
  id                 String         @id @default(uuid())
  code               Int            @unique @default(autoincrement())
  companyId          String         @map("company_id")
  title              String
  downtime           Boolean        @default(false)
  downtimeStart      DateTime?      @map("downtime_start")
  downtimeEnd        DateTime?      @map("downtime_end")
  responsibleId      String?        @map("responsible_id")
  summary            String?
  description        String?
  reason             String?
  impact             String?
  rollback           String?
  status             GmudStatus     @default(DRAFT)
  createdBy          String         @map("created_by")
  approvedAt         DateTime?      @map("approved_at")
  executionStartedAt DateTime?      @map("execution_started_at")
  executedAt         DateTime?      @map("executed_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator            User           @relation("UserCreatedGmuds", fields: [createdBy], references: [id])
  responsible        User?          @relation("UserResponsibleGmuds", fields: [responsibleId], references: [id])
  executors          GmudExecutor[]
  approvers          GmudApprover[]
  activities         GmudActivity[]
  attachments        GmudAttachment[]

  @@index([companyId])
  @@index([status])
  @@index([createdBy])
  @@index([responsibleId])
  @@map("gmud")
}

model GmudExecutor {
  id        String   @id @default(uuid())
  gmudId    String   @map("gmud_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  gmud      Gmud     @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gmudId, userId])
  @@index([gmudId])
  @@index([userId])
  @@map("gmud_executors")
}

model GmudApprover {
  id             String              @id @default(uuid())
  gmudId         String              @map("gmud_id")
  userId         String              @map("user_id")
  status         GmudApproverStatus  @default(PENDING)
  decidedAt      DateTime?           @map("decided_at")
  decisionNote   String?             @map("decision_note")

  gmud           Gmud                @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gmudId, userId])
  @@index([gmudId])
  @@index([userId])
  @@map("gmud_approvers")
}

model GmudActivity {
  id                String    @id @default(uuid())
  gmudId            String    @map("gmud_id")
  scheduledAt       DateTime  @map("scheduled_at")
  durationMinutes   Int       @map("duration_minutes")
  executorUserId    String    @map("executor_user_id")
  description       String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  gmud              Gmud      @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  executorUser      User      @relation("GmudActivityExecutor", fields: [executorUserId], references: [id], onDelete: Restrict)

  @@index([gmudId])
  @@index([executorUserId])
  @@map("gmud_activities")
}

model GmudAttachment {
  id          String   @id @default(uuid())
  gmudId      String   @map("gmud_id")
  fileId      String   @map("file_id")
  uploadedBy  String   @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  gmud        Gmud     @relation(fields: [gmudId], references: [id], onDelete: Cascade)
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploader    User     @relation("GmudAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([gmudId])
  @@index([fileId])
  @@index([uploadedBy])
  @@map("gmud_attachments")
}

model Report {
  id           String       @id @default(uuid())
  companyId    String       @map("company_id")
  type         ReportType
  format       ReportFormat @default(CSV)
  status       ReportStatus @default(READY)
  periodStart  DateTime  @map("period_start")
  periodEnd    DateTime  @map("period_end")
  filters      Json?     
  errorMessage String?   @map("error_message")
  generatedBy  String    @map("generated_by")
  fileId       String    @map("file_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file         File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fileId])
  @@map("reports")
}

model TicketStage {
  id            String    @id @default(uuid())
  name          String
  isSystem      Boolean   @default(false) @map("is_system")
  syncsToTiflux Boolean   @default(false) @map("syncs_to_tiflux")
  active        Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("ticket_stages")
}

model BillingEntry {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  contractId       String    @map("contract_id")
  monthReference   DateTime  @map("month_reference")
  contractedHours  Decimal   @db.Decimal(10, 2) @map("contracted_hours")
  usedHours        Decimal   @db.Decimal(10, 2) @map("used_hours")
  extraHours       Decimal   @db.Decimal(10, 2) @map("extra_hours")
  extraAmount      Decimal   @db.Decimal(10, 2) @map("extra_amount")
  createdAt        DateTime  @default(now()) @map("created_at")

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract         Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contractId])
  @@map("billing_entries")
}

model UsageAlertRule {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  enabled         Boolean  @default(true)
  // dia do mês para rodar (ex.: 15)
  dayOfMonth      Int      @default(15) @map("day_of_month")
  // percentuais (0..100)
  lowThresholdPct Int?     @map("low_threshold_pct")
  highThresholdPct Int?    @map("high_threshold_pct")
  recipients      Json     // { to: string[], cc?: string[] }
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([enabled, dayOfMonth])
  @@map("usage_alert_rules")
}

model IntegrationZabbixHost {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  zabbixHostId  String   @map("zabbix_host_id")
  hostName      String   @map("host_name")
  enabled       Boolean  @default(true)

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("integration_zabbix_hosts")
}

model IntegrationTiFluxAccount {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  tifluxCompanyId  String   @map("tiflux_company_id")
  enabled          Boolean  @default(true)

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("integration_tiflux_accounts")
}

model AuditLog {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  action     String
  entity     String
  entityId   String?   @map("entity_id")
  payload    Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model ExternalApiCache {
  id        String   @id @default(uuid())
  provider  String
  cacheKey  String   @unique @map("cache_key")
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at")
  expiresAt DateTime @map("expires_at")

  @@index([provider])
  @@index([expiresAt])
  @@map("external_api_cache")
}

enum PortalTifluxOutboxKind {
  CREATE_TICKET
  CREATE_APPOINTMENT
  UPDATE_TICKET
  UPDATE_APPOINTMENT
}

enum PortalTifluxOutboxStatus {
  PENDING
  SYNCED
  FAILED
}

/// Fila de escrita portal → TiFlux (opção A). Leitura canônica: schema tiflux.*
model PortalTifluxOutbox {
  id                String                   @id @default(uuid())
  kind              PortalTifluxOutboxKind
  status            PortalTifluxOutboxStatus @default(PENDING)
  ticketNumber      Int?                     @map("ticket_number")
  tifluxExternalId  Int?                     @map("tiflux_external_id")
  payload           Json
  errorMessage      String?                  @map("error_message")
  createdBy         String                   @map("created_by")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  syncedAt          DateTime?                @map("synced_at")

  creator           User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  appointmentAttachments PortalTicketAppointmentAttachment[]
  portalAppointments     PortalTicketAppointment[]

  @@index([status, createdAt])
  @@index([ticketNumber])
  @@map("portal_tiflux_outbox")
}

enum PortalTicketAppointmentSyncStatus {
  PENDING_TIFLUX
  SYNCED
  PORTAL_ONLY
}

/// Apontamento criado pelo portal (campos completos). TiFlux recebe só data/hora/descrição quando a API permitir.
model PortalTicketAppointment {
  id                          String                            @id @default(uuid())
  ticketNumber                Int                               @map("ticket_number")
  appointmentDate             DateTime                          @map("appointment_date") @db.Date
  initTime                    String                            @map("init_time") @db.VarChar(5)
  endTime                     String                            @map("end_time") @db.VarChar(5)
  description                 String
  serviceName                 String                            @map("service_name") @db.VarChar(120)
  attendance                  String                            @db.VarChar(20)
  tifluxAppointmentExternalId Int?                              @map("tiflux_appointment_external_id")
  syncStatus                  PortalTicketAppointmentSyncStatus @default(PENDING_TIFLUX) @map("sync_status")
  syncPausedAt                DateTime?                         @map("sync_paused_at")
  outboxId                    String?                           @map("outbox_id")
  createdBy                   String                            @map("created_by")
  createdAt                   DateTime                          @default(now()) @map("created_at")
  updatedAt                   DateTime                          @updatedAt @map("updated_at")

  creator     User                                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  outbox      PortalTifluxOutbox?                 @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  attachments PortalTicketAppointmentAttachment[]
  projectActivityLink ProjectActivityAppointment?

  @@index([ticketNumber])
  @@index([tifluxAppointmentExternalId])
  @@map("portal_ticket_appointments")
}

/// Anexos do portal em apontamentos (não vão para o TiFlux).
model PortalTicketAppointmentAttachment {
  id                        String   @id @default(uuid())
  ticketNumber              Int      @map("ticket_number")
  portalAppointmentId       String?  @map("portal_appointment_id")
  outboxId                  String?  @map("outbox_id")
  tifluxAppointmentExternalId Int?   @map("tiflux_appointment_external_id")
  fileId                    String   @map("file_id")
  previewDataBase64         String?  @map("preview_data_base64") @db.Text
  createdBy                 String   @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")

  file              File                     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  creator           User                     @relation("PortalTicketAppointmentAttachmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  outbox            PortalTifluxOutbox?      @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  portalAppointment PortalTicketAppointment? @relation(fields: [portalAppointmentId], references: [id], onDelete: SetNull)

  @@index([ticketNumber])
  @@index([outboxId])
  @@index([portalAppointmentId])
  @@map("portal_ticket_appointment_attachments")
}

/// Descrição rica do chamado criada no portal (texto + imagens embutidas).
model PortalTicketDescription {
  ticketNumber Int      @id @map("ticket_number")
  description  String
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator User @relation("PortalTicketDescriptionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("portal_ticket_descriptions")
}

/// Referência GMUD externa (informada pelo cliente) vinculada ao ticket TiFlux.
model PortalTicketGmudLink {
  ticketNumber    Int      @id @map("ticket_number")
  externalGmudRef String   @map("external_gmud_ref") @db.VarChar(120)
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([externalGmudRef])
  @@map("portal_ticket_gmud_links")
}

enum RendimentoAppointmentQuestionStatus {
  PENDING
  ANSWERED
}

/// Questionamento de apontamento pela visão empresarial (cliente → admins).
model RendimentoAppointmentQuestion {
  id                String                              @id @default(uuid())
  companyId         String                              @map("company_id")
  appointmentSource String                              @map("appointment_source") @db.VarChar(16)
  appointmentRef    String                              @map("appointment_ref") @db.VarChar(64)
  ticketNumber      Int                                 @map("ticket_number")
  appointmentDate   DateTime                            @map("appointment_date") @db.Date
  initTime          String?                             @map("init_time") @db.VarChar(5)
  endTime           String?                             @map("end_time") @db.VarChar(5)
  userName          String?                             @map("user_name") @db.VarChar(255)
  description       String?
  message           String
  status            RendimentoAppointmentQuestionStatus @default(PENDING)
  adminResponse     String?                             @map("admin_response")
  adminResponseCode String?                             @map("admin_response_code") @db.VarChar(64)
  abonado           Boolean                             @default(false)
  questionedBy      String                              @map("questioned_by")
  respondedBy       String?                             @map("responded_by")
  respondedAt       DateTime?                           @map("responded_at")
  createdAt         DateTime                            @default(now()) @map("created_at")
  updatedAt         DateTime                            @updatedAt @map("updated_at")

  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  questioner  User    @relation("RendimentoQuestionAskedBy", fields: [questionedBy], references: [id], onDelete: Restrict)
  responder   User?   @relation("RendimentoQuestionAnsweredBy", fields: [respondedBy], references: [id], onDelete: SetNull)

  @@index([companyId, appointmentDate])
  @@index([status])
  @@map("rendimento_appointment_questions")
}

/// Tabelas de rendimento criadas via SQL — mapeadas para evitar drift com migrations.
model RendimentoDayEvent {
  id                    String    @id
  userId                String    @map("user_id")
  dateRef               DateTime  @map("date_ref") @db.Date
  eventType             String    @map("event_type")
  fromTime              DateTime? @map("from_time") @db.Time
  toTime                DateTime? @map("to_time") @db.Time
  minutes               Int       @default(0)
  appointmentExternalId BigInt?   @map("appointment_external_id")
  justificationId       String?   @map("justification_id")
  label                 String?
  description           String?
  reason                String?
  status                String    @default("ACTIVE")
  debitProtected        Boolean   @default(false) @map("debit_protected")
  sourceKey             String    @map("source_key")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  approvedBy            String?   @map("approved_by")
  approvedAt            DateTime? @map("approved_at")
  deletedAt             DateTime? @map("deleted_at")

  user User @relation("RendimentoDayEvents", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, dateRef])
  @@index([eventType, status])
  @@map("rendimento_day_events")
}

model RendimentoGapJustification {
  id              String    @id
  userId          String    @map("user_id")
  dateRef         DateTime  @map("date_ref") @db.Date
  fromTime        DateTime  @map("from_time") @db.Time
  toTime          DateTime  @map("to_time") @db.Time
  gapType         String    @map("gap_type")
  gapMinutes      Int       @map("gap_minutes")
  kind            String
  status          String    @default("PENDING")
  reason          String
  debitOvertime   Boolean   @default(false) @map("debit_overtime")
  overtimeMinutes Int       @default(0) @map("overtime_minutes")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  note            String?
  deletedAt       DateTime? @map("deleted_at")

  user User @relation("RendimentoGapJustifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateRef])
  @@index([status])
  @@map("rendimento_gap_justifications")
}

model RendimentoOvertimeBalance {
  userId    String   @id @map("user_id")
  minutes   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation("RendimentoOvertimeBalances", fields: [userId], references: [id], onDelete: Cascade)

  @@map("rendimento_overtime_balances")
}

/// Visibilidade de colaboradores na lista de Apontamentos (global para todos os admins).
model RendimentoCollaboratorListPref {
  collaboratorUserId String   @id @map("collaborator_user_id")
  listed             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  collaborator User @relation("RendimentoListPrefCollaborator", fields: [collaboratorUserId], references: [id], onDelete: Cascade)

  @@map("rendimento_collaborator_list_prefs")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum ProjectBudgetUnit {
  HOURS
  DAYS
}

enum ProjectCompletionApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Project {
  id          String        @id @default(uuid())
  code        Int           @unique @default(autoincrement())
  companyId   String        @map("company_id")
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  budgetUnit  ProjectBudgetUnit? @map("budget_unit")
  budgetAmount Int?         @map("budget_amount")
  completionApprovalStatus ProjectCompletionApprovalStatus @default(NOT_REQUIRED) @map("completion_approval_status")
  completionApprovedBy String? @map("completion_approved_by")
  completionApprovedAt DateTime? @map("completion_approved_at")
  completionApprovalNote String? @map("completion_approval_note")
  ticketNumber Int? @unique @map("ticket_number")
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator    User              @relation("ProjectCreator", fields: [createdBy], references: [id])
  completionApprover User?     @relation("ProjectCompletionApprover", fields: [completionApprovedBy], references: [id])
  activities ProjectActivity[]
  documents  ProjectDocument[]

  @@index([companyId])
  @@index([status])
  @@index([completionApprovalStatus])
  @@index([ticketNumber])
  @@map("projects")
}

model ProjectActivity {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  parentId           String?   @map("parent_id")
  wbsCode            String    @map("wbs_code")
  name               String
  level              Int       @default(1)
  sortOrder          Int       @default(0) @map("sort_order")
  durationDays       Int       @default(1) @map("duration_days")
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  actualDurationDays Int?      @map("actual_duration_days")
  progressPercent    Int       @default(0) @map("progress_percent")
  assigneeUserId     String?   @map("assignee_user_id")
  assigneeName       String?   @map("assignee_name")
  isMilestone        Boolean   @default(false) @map("is_milestone")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  project      Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       ProjectActivity?             @relation("ProjectActivityTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     ProjectActivity[]            @relation("ProjectActivityTree")
  assignee     User?                        @relation("ProjectActivityAssignee", fields: [assigneeUserId], references: [id])
  predecessors ProjectActivityPredecessor[] @relation("ActivitySuccessors")
  successors   ProjectActivityPredecessor[] @relation("ActivityPredecessors")
  appointments ProjectActivityAppointment[]

  @@unique([projectId, wbsCode])
  @@index([projectId])
  @@index([parentId])
  @@index([assigneeUserId])
  @@map("project_activities")
}

model ProjectActivityPredecessor {
  id            String   @id @default(uuid())
  activityId    String   @map("activity_id")
  predecessorId String   @map("predecessor_id")
  createdAt     DateTime @default(now()) @map("created_at")

  activity    ProjectActivity @relation("ActivitySuccessors", fields: [activityId], references: [id], onDelete: Cascade)
  predecessor ProjectActivity @relation("ActivityPredecessors", fields: [predecessorId], references: [id], onDelete: Cascade)

  @@unique([activityId, predecessorId])
  @@index([activityId])
  @@index([predecessorId])
  @@map("project_activity_predecessors")
}

model ProjectActivityAppointment {
  id                  String   @id @default(uuid())
  activityId          String   @map("activity_id")
  portalAppointmentId String   @unique @map("portal_appointment_id")
  minutes             Int
  createdAt           DateTime @default(now()) @map("created_at")

  activity          ProjectActivity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  portalAppointment PortalTicketAppointment @relation(fields: [portalAppointmentId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("project_activity_appointments")
}

model ProjectDocument {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  fileId    String   @map("file_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fileId])
  @@map("project_documents")
}