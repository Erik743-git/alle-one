## Backend (.env) — exemplo para PRODUÇÃO
#
# - NÃO comite valores reais (senhas/tokens).
# - No Coolify, configure tudo em "Environment Variables / Secrets".

# Runtime
NODE_ENV=production
# VM com PM2/Nginx: 3002 | dev local: 3003
PORT=3002
TRUST_PROXY=1
SWAGGER_ENABLED=false
# Opcional: prefixo global (use com Nginx /api — ver deploy/MIGRACAO_NGINX_API.md)
# API_GLOBAL_PREFIX=api

# CORS (origens exatas, separadas por vírgula; sem barra no final)
# Ex.: "https://alleone.alletecnologia.com"
CORS_ORIGINS="https://SEU-DOMINIO"

# Banco (em Docker Compose, o host normalmente é "postgres")
DATABASE_URL="postgresql://USER:PASSWORD@postgres:5432/alleone?schema=public"

# JWT (32+ caracteres aleatórios)
JWT_SECRET="defina_um_segredo_longo_e_unico"
JWT_EXPIRES_IN="1d"

# Cookie de sessão (produção: strict reduz risco de CSRF)
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_SECURE=true

# Login social (opcional — só usuários já cadastrados no portal)
# Dev local: callback direto na API ou via rewrite do Next (localhost:3000/auth → API)
AUTH_OAUTH_CALLBACK_BASE_URL="http://127.0.0.1:3002"
# Produção (Nginx): domínio HTTPS público, sem porta — ex. https://alleone.alletecnologia.com
# Cadastre no Google/Azure: .../auth/google/callback e .../auth/microsoft/callback
FRONTEND_URL="http://127.0.0.1:3000"
PORTAL_PUBLIC_URL=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
# common | organizations | tenant-id
MICROSOFT_OAUTH_TENANT_ID="common"

# Monitoramento integrações (/health/integrations)
TIFLUX_SYNC_STALE_HOURS=6
TIFLUX_SYNC_STALE_ALERT_COOLDOWN_HOURS=6
TIFLUX_OUTBOX_DISABLED=false
TIFLUX_OUTBOX_PENDING_STALE_MINUTES=30

# Apontamentos portal -> API TiFlux (outbox). Padrao: false (somente portal).
# TIFLUX_APPOINTMENT_SYNC_ENABLED=true

# Worker outbox dedicado (PM2 alleone-outbox): true na API
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_DRIVER=s3
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=us-east-1
# FILE_STORAGE_S3_ENDPOINT=
# FILE_STORAGE_S3_FORCE_PATH_STYLE=true
# FILE_STORAGE_S3_ACCESS_KEY_ID=
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=
# FILE_STORAGE_S3_PREFIX=alleone

# E-mail (opcional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Alle One <no-reply@seu-dominio>"

# Integrações (opcional)
ZABBIX_URL=""
ZABBIX_TOKEN=""
# Leitura do schema zabbix.* (worker alleone-zabbix-sync). Padrão: true
ZABBIX_USE_DB_CACHE=true
ZABBIX_DB_STALE_HOURS=2
# Paginação event.get do dashboard (fallback API)
ZABBIX_DASHBOARD_EVENTS_LIMIT=5000
ZABBIX_DASHBOARD_EVENTS_MAX_PAGES=80
# Cache Postgres do pack Zabbix (grupo + período). 1h padrão; histórico pode usar 21600000 (6h).
ZABBIX_DASHBOARD_CACHE_MS=3600000
ZABBIX_DASHBOARD_CACHE_ENABLED=true
# Cache em memória do /dashboard/complete (ms)
# DASHBOARD_COMPLETE_CACHE_MS=180000
TIFLUX_API_URL="https://api.tiflux.com/api/v2"
TIFLUX_TOKEN=""

# Cache TiFlux: use o projeto alleone-tiflux-sync (fora deste repo) para popular schema tiflux.*
TIFLUX_RUNTIME_API=false
TIFLUX_UNSAFE_ENDPOINTS=false
