## Backend (.env) — exemplo para PRODUÇÃO
#
# - NÃO comite valores reais (senhas/tokens).
# - No Coolify, configure tudo em "Environment Variables / Secrets".

# Runtime
NODE_ENV=production
# VM com PM2/Nginx: 3002 | dev local: 3003
PORT=3002
TRUST_PROXY=1
SWAGGER_ENABLED=false
# Opcional: prefixo global (produção com Nginx /api — ver deploy/MIGRACAO_NGINX_API.md)
# API_GLOBAL_PREFIX=api

# CORS (origens exatas, separadas por vírgula; sem barra no final)
# Ex.: "https://alleone.alletecnologia.com"
CORS_ORIGINS="https://SEU-DOMINIO"

# Banco (em Docker Compose, o host normalmente é "postgres")
DATABASE_URL="postgresql://USER:PASSWORD@postgres:5432/alleone?schema=public"

# JWT (32+ caracteres aleatórios)
JWT_SECRET="defina_um_segredo_longo_e_unico"
JWT_EXPIRES_IN="1d"

# Cookie de sessão (produção: strict reduz risco de CSRF)
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_SECURE=true

# Login social (opcional — só usuários já cadastrados no portal)
# Produção (Nginx): domínio HTTPS público, sem porta
PORTAL_PUBLIC_URL="https://alleone.alletecnologia.com"
AUTH_OAUTH_CALLBACK_BASE_URL="https://alleone.alletecnologia.com"
FRONTEND_URL="https://alleone.alletecnologia.com"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
# common | organizations | tenant-id
MICROSOFT_OAUTH_TENANT_ID="common"

# Monitoramento integrações (/health/integrations)
# Token interno para cron/health-check (header X-Internal-Health-Token).
# Sem token: apenas ADMIN autenticado (cookie JWT).
HEALTH_INTEGRATIONS_TOKEN=""
TIFLUX_SYNC_STALE_HOURS=6
TIFLUX_SYNC_STALE_ALERT_COOLDOWN_HOURS=6
TIFLUX_OUTBOX_DISABLED=false
TIFLUX_OUTBOX_PENDING_STALE_MINUTES=30

# Cutover tickets portal (docs/CUTOVER_TIFLUX.md + CUTOVER_RUNBOOK.md)
# Produção (conservador): leitura espelho TiFlux + write na API.
# TICKETS_PORTAL_CANONICAL=false
# TICKETS_TIFLUX_WRITE=true
#
# Desvinculação total (portal-only runtime):
# TICKETS_PORTAL_CANONICAL=true
# TICKETS_TIFLUX_WRITE=false
# TIFLUX_DISCONNECTED=true
# TIFLUX_APPOINTMENT_SYNC_ENABLED=false
# TIFLUX_OUTBOX_DISABLED=true
# TIFLUX_RUNTIME_API=false
TICKETS_PORTAL_CANONICAL=false
TICKETS_TIFLUX_WRITE=true
# TIFLUX_DISCONNECTED=true

# Apontamentos portal -> API TiFlux (outbox). Padrao: false (somente portal).
# TIFLUX_APPOINTMENT_SYNC_ENABLED=true
# TIFLUX_OUTBOX_DISABLED=true
# Sync de apontamentos: somente tickets da mesa AlleOne no TiFlux (ID ou nome).
# TIFLUX_PORTAL_DESK_ID=59316
# TIFLUX_PORTAL_DESK_NAME=AlleOne
# Alterar estágio do ticket: PATCH /tickets/:ticketNumber/stage (portal -> API TiFlux PUT)

# Worker outbox dedicado (PM2 alleone-outbox): true na API
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_DRIVER=s3
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=us-east-1
# FILE_STORAGE_S3_ENDPOINT=
# FILE_STORAGE_S3_FORCE_PATH_STYLE=true
# FILE_STORAGE_S3_ACCESS_KEY_ID=
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=
# FILE_STORAGE_S3_PREFIX=alleone

# E-mail (opcional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Alle One <no-reply@seu-dominio>"

# Redis / filas (BullMQ). Sem REDIS_URL: poller cron processa e-mail in-process.
# REDIS_URL="redis://127.0.0.1:6379"
# EMAIL_INBOUND_POLL_DISABLED=false

# Microsoft Graph (e-mail → pré-ticket). Shared mailbox + app-only Mail.Read.
# GRAPH_TENANT_ID=""
# GRAPH_CLIENT_ID=""
# GRAPH_CLIENT_SECRET=""

# Sentry (opcional)
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_DSN=""  # frontend

# 2FA TOTP
# TOTP_ENCRYPTION_KEY=""  # senão usa JWT_SECRET
# TOTP_ADMIN_REQUIRED=false
# TOTP_ADMIN_GRACE_DAYS=14
# TOTP_TRUST_DAYS=14  # “não pedir 2FA neste dispositivo” (máx. 30)

# Integrações (opcional)
ZABBIX_URL=""
ZABBIX_TOKEN=""
# Leitura do schema zabbix.* (worker alleone-zabbix-sync). Padrão: true
ZABBIX_USE_DB_CACHE=true
ZABBIX_DB_STALE_HOURS=2
# Paginação event.get do dashboard (fallback API)
ZABBIX_DASHBOARD_EVENTS_LIMIT=5000
ZABBIX_DASHBOARD_EVENTS_MAX_PAGES=80
# Cache Postgres do pack Zabbix (grupo + período). 1h padrão; histórico pode usar 21600000 (6h).
ZABBIX_DASHBOARD_CACHE_MS=3600000
ZABBIX_DASHBOARD_CACHE_ENABLED=true
# Cache em memória do /dashboard/complete (ms) e teto de entradas
# DASHBOARD_COMPLETE_CACHE_MS=180000
# DASHBOARD_COMPLETE_CACHE_MAX=40
# Cache em memória do /dashboard/hours (ms) e teto de entradas
# DASHBOARD_HOURS_CACHE_MS=600000
# DASHBOARD_HOURS_CACHE_MAX=60
# L2 Redis para horas (requer REDIS_URL): DASHBOARD_HOURS_REDIS_CACHE=true
# L2 Redis para complete (requer REDIS_URL): DASHBOARD_COMPLETE_REDIS_CACHE=true
TIFLUX_API_URL="https://api.tiflux.com/api/v2"
TIFLUX_TOKEN=""

# Cache TiFlux em Postgres (external_api_cache) para GETs da API
# EXTERNAL_API_CACHE_ENABLED=true
# EXTERNAL_API_CACHE_TTL_MS=600000

# Cache TiFlux: use o projeto alleone-tiflux-sync (fora deste repo) para popular schema tiflux.*
TIFLUX_RUNTIME_API=false
TIFLUX_UNSAFE_ENDPOINTS=false
