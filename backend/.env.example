# Copie para .env e preencha com valores reais (não commite o .env).
#
# NODE_ENV=production no deploy (Swagger /docs desligado por padrão; use SWAGGER_ENABLED=true só se necessário).
# TRUST_PROXY=1 atrás de reverse proxy (nginx, load balancer) para IP e cookies corretos.

# --- Core ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alleone?schema=public"
PORT=3003
PORT_FALLBACK_ATTEMPTS=25

# Obrigatório — a API não sobe sem isso (JwtModule).
JWT_SECRET="defina_um_segredo_longo_e_unico"
JWT_EXPIRES_IN="1d"

FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Dump de debug (TiFlux/Zabbix) — desligado em produção; em dev só com true
ENABLE_DEBUG_DUMP=false
PORTAL_PUBLIC_URL="http://localhost:3000"

# TRUST_PROXY=1
# SWAGGER_ENABLED=true

# Cookie do JWT (httpOnly). Em API e front em domínios diferentes use AUTH_COOKIE_SAMESITE=none (exige HTTPS).
# AUTH_COOKIE_DOMAIN=.seudominio.com
# AUTH_COOKIE_SAMESITE=lax

# Seed (npx prisma db seed): em produção exige ADMIN_SEED_PASSWORD com no mínimo 12 caracteres.
# ADMIN_SEED_PASSWORD=""

# --- E-mail (SMTP ou OAuth Gmail; use o fluxo que o MailService suportar) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Alle One <noreply@example.com>"
SMTP_TLS_REJECT_UNAUTHORIZED=true

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# --- Integrações ---
ZABBIX_URL=""
ZABBIX_TOKEN=""
ZABBIX_DASHBOARD_EVENTS_LIMIT=
# Páginas na busca paginada de eventos do dashboard (tamanho da página = LIMIT acima)
# ZABBIX_DASHBOARD_EVENTS_MAX_PAGES=40

TIFLUX_API_URL="https://api.tiflux.com/api/v2"
TIFLUX_TOKEN=""
TIFLUX_USE_DB_CACHE=true
# true = horas só do SQL se max(appointment_date) cobrir a data final do filtro (pode forçar API lenta se o sync estiver 1–2 dias atrás)
# TIFLUX_DB_CACHE_REQUIRE_FULL_COVERAGE=true
# Sem dados no SQL: listagem de tickets para horas recua N dias no início do filtro (tickets antigos com apontamento no período, como no extrato CSV). 0–3650; omissão 730.
# TIFLUX_HOURS_TICKET_LOOKBACK_DAYS=730
# true = horas do dashboard só com GET /tickets + apontamentos como na doc v2 (sem união created/updated, sem cache SQL, sem pós-filtro garantia/range no cliente).
# TIFLUX_DASHBOARD_RAW_API=true
# Linhas na tabela "Resumo de horas trabalhadas" (1–100000; omissão = 50000).
# TIFLUX_RESUMO_MAX_LINHAS=50000
TIFLUX_TIMEOUT_MS=12000
TIFLUX_MAX_RETRIES=
TIFLUX_MIN_REQUEST_INTERVAL_MS=

# Cache HTTP externo (TiFlux etc.)
EXTERNAL_API_CACHE_ENABLED=true
EXTERNAL_API_CACHE_TTL_MS=
EXTERNAL_API_CACHE_SHORT_TTL_MS=
EXTERNAL_API_CACHE_LONG_TTL_MS=

# --- Dashboard (opcional) ---
DASHBOARD_COMPLETE_CACHE_MS=
TIFLUX_DASHBOARD_HOURS_APPOINTMENT_DATE_ONLY=true
