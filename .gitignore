# Raiz do monorepo — reforça ignores comuns (cada app tem o seu .gitignore também)

# Ambiente (nunca commitar segredos)
.env
.env.*
!.env.example
!**/.env.example

# SO / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# Logs e temporários na raiz
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads de runtime (logos, relatórios, anexos)
backend/uploads/**
!backend/uploads/.gitkeep

# Scripts/relatórios locais de import TiFlux (não versionar)
backend/exports/
