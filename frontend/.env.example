# Copie para .env.local (recomendado no Next.js).

# URL base da API (porta do backend/.env PORT, ex. 3002 ou 3003)
#
# No PC onde rodam backend+front (escritório):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:3002
#   Abra o site em http://localhost:3000
#
# De outro PC via Tailscale (casa → trabalho):
#   NEXT_PUBLIC_API_URL=http://100.x.x.x:3002  (IP Tailscale do PC do trabalho)
#   Abra http://100.x.x.x:3000
#   Não use o IP Tailscale no próprio PC do trabalho (pode dar timeout).
NEXT_PUBLIC_API_URL="http://127.0.0.1:3002"
