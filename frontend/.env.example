# Copie para .env.local (recomendado no Next.js).

# URL base da API (porta do backend/.env PORT, ex. 3002 ou 3003)
#
# Dev local (sem prefixo /api):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:3002
#
# Produção (Nginx unificado — ver deploy/MIGRACAO_NGINX_API.md):
#   NEXT_PUBLIC_API_URL=https://alleone.alletecnologia.com/api
#
# De outro PC via Tailscale (casa → trabalho):
#   NEXT_PUBLIC_API_URL=http://100.x.x.x:3002  (IP Tailscale do PC do trabalho)
NEXT_PUBLIC_API_URL="http://127.0.0.1:3002"

# ANTIGO: quem liga e desliga modulo agora e Administracao > Acesso por perfil
# (vale no menu e na API, sem rebuild). Esta variavel so cobre a sessao salva
# antes da atualizacao, ate o proximo /auth/me. Pode ficar vazia.
NEXT_PUBLIC_MODULOS_DESABILITADOS=""

# Tarja de ambiente de teste (moldura ambar + selo "Ambiente de teste").
# "teste" mostra, "producao" esconde. Vazia: decide pelo endereco (host com
# teste/homolog/staging mostra). Resolvida no BUILD.
NEXT_PUBLIC_AMBIENTE=""
